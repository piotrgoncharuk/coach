# Синхронизация включается появлением этих двух переменных.
# Без них приложение работает полностью локально (IndexedDB), данные не теряются.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ТОЛЬКО на сервере (переменные окружения Netlify), никогда в репозитории и никогда в VITE_*:
# SUPABASE_SERVICE_ROLE_KEY=
